    { "id": "reservoirC", "kind": "objects", "required": true },
    { "id": "quantity", "kind": "label", "required": true },
    { "id": "transferLabels", "kind": "label", "required": true }
  ],
  "stageEvents": [
    { "id": "establish-reservoirs", "at": 0.12, "observable": "three reservoirs and the conserved set are readable before any transfer" },
    { "id": "transfer-a-to-b", "at": 0.34, "observable": "one visible unit leaves reservoir A and appears in reservoir B" },
    { "id": "transfer-b-to-c", "at": 0.57, "observable": "the same visible unit leaves reservoir B and appears in reservoir C" },
    { "id": "close-exchange", "at": 0.86, "observable": "the unit returns from reservoir C to reservoir A and the original distribution is restored" }
  ],
  "layout": {
    "aspectRatios": ["16:9", "9:16", "1:1"],
