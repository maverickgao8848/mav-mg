    "transfer-path"
  ],
  "handoff": {
    "entry": ["reservoir-a", "conserved-set"],
    "exit": ["restored-distribution", "closed-exchange-path"]
  },
  "limits": [
    "exactly three reservoirs",
    "one conserved quantity only",
